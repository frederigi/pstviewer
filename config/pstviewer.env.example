# ============================================================================
# PST Viewer - Arquivo de Configuração de Ambiente (/opt/pstviewer/config/pstviewer.env)
# Permissões obrigatórias: 0640 (root:pstviewer)
# ============================================================================

PSTVIEWER_ENV=production
PSTVIEWER_APP_NAME="PST Viewer"
PSTVIEWER_BIND_HOST=127.0.0.1
PSTVIEWER_BIND_PORT=8000

# Banco de Dados Principal (MySQL / MariaDB InnoDB obrigatório - SQLite é proibido)
PSTVIEWER_DB_HOST=127.0.0.1
PSTVIEWER_DB_PORT=3306
PSTVIEWER_DB_NAME=pstviewer
PSTVIEWER_DB_USER=pstviewer_app
PSTVIEWER_DB_PASSWORD=ALTERAR_PELO_INSTALADOR

# Diretórios de Armazenamento Temporário e Logs
PSTVIEWER_SESSIONS_DIR=/srv/pstviewer/sessions
PSTVIEWER_QUARANTINE_DIR=/srv/pstviewer/quarantine
PSTVIEWER_JOBS_DIR=/var/lib/pstviewer/jobs
PSTVIEWER_LOG_DIR=/var/log/pstviewer

# Segurança de Sessão e Cookies
PSTVIEWER_SECRET_KEY=ALTERAR_PELO_INSTALADOR_64_HEX
PSTVIEWER_COOKIE_SECURE=true
PSTVIEWER_AUTH_SESSION_HOURS=8
PSTVIEWER_MAX_LOGIN_ATTEMPTS=5
PSTVIEWER_LOGIN_LOCKOUT_MINUTES=15

